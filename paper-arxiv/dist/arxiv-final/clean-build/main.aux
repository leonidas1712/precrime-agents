\newlabel{sec:percall@cref}{{[subsection][1][4]4.1}{[1][7][]7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The nearer the act, the more predictable the leak.} For each model, the probe is asked three questions about the same calls, each label defined from the same leak, from ``will this episode ever leak?'' to ``will this call leak?''. Hollow markers are held-out scenarios on development episodes; filled markers are test episodes, each scored once by a model fit only on development episodes. On gpt-oss-20b, the filled diamond is the reasoning probe; the circles are the last-prompt probe. AUROC is computed within each scenario and round, so 0.5 is chance; whiskers are 95\% bootstrap intervals.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:headline}{{3}{8}{\textbf {The nearer the act, the more predictable the leak.} For each model, the probe is asked three questions about the same calls, each label defined from the same leak, from ``will this episode ever leak?'' to ``will this call leak?''. Hollow markers are held-out scenarios on development episodes; filled markers are test episodes, each scored once by a model fit only on development episodes. On gpt-oss-20b, the filled diamond is the reasoning probe; the circles are the last-prompt probe. AUROC is computed within each scenario and round, so 0.5 is chance; whiskers are 95\% bootstrap intervals}{figure.3}{}}
\newlabel{fig:headline@cref}{{[figure][3][]3}{[1][7][]8}{}{}{}}
