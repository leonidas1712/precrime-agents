\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {How an episode works.} (a)~A real leak on Qwen3-32B, verbatim and shortened, with the token redacted; the leaking message is highlighted. (b)~The peer (horns) asks over the team channel for the token held by the target (halo), which is bound by its operator's rule. Solid arrows are actions; dashed arrows are observation: the text monitor reads the transcript, and the probe reads the target's activations $h_\ell (x_t)$ before each output $o_t$. (c)~The three labels on one schematic episode; shaded calls are those scored after the first read (\cref  {app:scenarios} gives a matched episode in which the target never leaks).}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:episode}{{1}{2}{\textbf {How an episode works.} (a)~A real leak on Qwen3-32B, verbatim and shortened, with the token redacted; the leaking message is highlighted. (b)~The peer (horns) asks over the team channel for the token held by the target (halo), which is bound by its operator's rule. Solid arrows are actions; dashed arrows are observation: the text monitor reads the transcript, and the probe reads the target's activations $h_\ell (x_t)$ before each output $o_t$. (c)~The three labels on one schematic episode; shaded calls are those scored after the first read (\cref {app:scenarios} gives a matched episode in which the target never leaks)}{figure.1}{}}
\newlabel{fig:episode@cref}{{[figure][1][]1}{[1][1][]2}{}{}{}}
