\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Flagging no more calls, the zero-shot monitor catches far fewer leaks than the probe.} Share of leaking calls caught against the share of calls in refusing episodes flagged, as the threshold moves, on Qwen3-32B test episodes. The filled circle is the probe at its threshold set on control calls. The filled square is Jev at the cutoff that flags no more calls in refusing episodes than the probe. The hollow diamond is the stricter per-episode threshold, plotted at its per-call rates. Labels give the share of leaking calls caught and of refusing-episode calls flagged at each marker. The grey dashed line is the trained text classifier, reading the latest message, on the same test calls; at the same flag rate it catches fewer leaks than the probe.}}{10}{figure.5}\protected@file@percent }
\newlabel{fig:qwen-alarms}{{5}{10}{\textbf {Flagging no more calls, the zero-shot monitor catches far fewer leaks than the probe.} Share of leaking calls caught against the share of calls in refusing episodes flagged, as the threshold moves, on Qwen3-32B test episodes. The filled circle is the probe at its threshold set on control calls. The filled square is Jev at the cutoff that flags no more calls in refusing episodes than the probe. The hollow diamond is the stricter per-episode threshold, plotted at its per-call rates. Labels give the share of leaking calls caught and of refusing-episode calls flagged at each marker. The grey dashed line is the trained text classifier, reading the latest message, on the same test calls; at the same flag rate it catches fewer leaks than the probe}{figure.5}{}}
\newlabel{fig:qwen-alarms@cref}{{[figure][5][]5}{[1][9][]10}{}{}{}}
