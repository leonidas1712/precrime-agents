\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Per-call results on both models (AUROC within scenario and round).} Development results are on held-out scenarios, and -- means not run. Intervals are in the appendices. ``One call earlier?'' asks whether the next call will leak, with the leaking call removed. For each model the text classifier shows the stronger of its two views, which favours it: the latest message on Qwen3-32B and the full input on gpt-oss-20b. Jev's 0.40{} on gpt-oss-20b is below chance because it ranks leaking calls below the other calls under the same pressure (\cref  {sec:monitor}).}}{7}{table.2}\protected@file@percent }
\newlabel{tab:glance}{{2}{7}{\textbf {Per-call results on both models (AUROC within scenario and round).} Development results are on held-out scenarios, and -- means not run. Intervals are in the appendices. ``One call earlier?'' asks whether the next call will leak, with the leaking call removed. For each model the text classifier shows the stronger of its two views, which favours it: the latest message on Qwen3-32B and the full input on gpt-oss-20b. Jev's \gptossCallJev {} on gpt-oss-20b is below chance because it ranks leaking calls below the other calls under the same pressure (\cref {sec:monitor})}{table.2}{}}
\newlabel{tab:glance@cref}{{[table][2][]2}{[1][7][]7}{}{}{}}
