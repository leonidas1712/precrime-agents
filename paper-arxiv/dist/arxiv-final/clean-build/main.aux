\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {A probe picks out the call that leaks; a zero-shot monitor does not, and a trained text classifier comes close.} Per-call AUROC on held-out scenarios, development episodes. Whiskers are bootstrap intervals (\cref  {app:probes}). The zero-shot monitor (Jev) sees the conversation and tool results that the last-prompt probe sees, with the secret masked. On gpt-oss-20b it scores below chance because it ranks leaking calls below the other calls under the same pressure. For each model the trained text classifier shows the stronger of its two text views, which favours it: the last message on Qwen3-32B and the full input on gpt-oss-20b. \Cref  {tab:text-baselines} gives both.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:percall}{{4}{9}{\textbf {A probe picks out the call that leaks; a zero-shot monitor does not, and a trained text classifier comes close.} Per-call AUROC on held-out scenarios, development episodes. Whiskers are bootstrap intervals (\cref {app:probes}). The zero-shot monitor (Jev) sees the conversation and tool results that the last-prompt probe sees, with the secret masked. On gpt-oss-20b it scores below chance because it ranks leaking calls below the other calls under the same pressure. For each model the trained text classifier shows the stronger of its two text views, which favours it: the last message on Qwen3-32B and the full input on gpt-oss-20b. \Cref {tab:text-baselines} gives both}{figure.4}{}}
\newlabel{fig:percall@cref}{{[figure][4][]4}{[1][8][]9}{}{}{}}
