\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Which tokens each detector reads.} In one call $t$, the model reads the prompt $x_t$, then writes reasoning $z_t$ (gpt-oss-20b only) and an output $o_t$. The last-prompt probe reads one position, the last prompt token, so its score is ready before anything is generated. The incoming-only probe reads every token new since the previous call, and the reasoning probe reads every token of $z_t$, so its score is ready before $o_t$ is executed. The text monitor and classifier read the text of $x_t$ with the secret masked, and an output filter can act only after $o_t$ is written.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:positions}{{2}{4}{\textbf {Which tokens each detector reads.} In one call $t$, the model reads the prompt $x_t$, then writes reasoning $z_t$ (gpt-oss-20b only) and an output $o_t$. The last-prompt probe reads one position, the last prompt token, so its score is ready before anything is generated. The incoming-only probe reads every token new since the previous call, and the reasoning probe reads every token of $z_t$, so its score is ready before $o_t$ is executed. The text monitor and classifier read the text of $x_t$ with the secret masked, and an output filter can act only after $o_t$ is written}{figure.2}{}}
\newlabel{fig:positions@cref}{{[figure][2][]2}{[1][4][]4}{}{}{}}
